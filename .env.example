# 复制为 .env：  copy .env.example .env
# 只有「本地服务」和「经后端代理」模式需要这个文件；纯静态页面（GitHub Pages）不需要任何后端配置。

# ----------------------------------------------------------------------------
# 1. 服务端模型（可选）
#    只有网页上选择「经后端代理」时才用到：Key 留在服务端，浏览器拿不到。
#    如果你在网页上选「直连模型」并填自己的临时 Key，这里可以不配。
# ----------------------------------------------------------------------------
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-在这里填你的key
LLM_MODEL=deepseek-chat

# 也可以复用瑞幸 CLI 自己的模型配置：
#   luckin models add deepseek --base-url https://api.deepseek.com --model deepseek-chat --api-key DEEPSEEK_API_KEY --set-active
# 本项目检测到 .env 没配时会自动读取 ~/.luckin/config.json 的 models.profiles。

# ----------------------------------------------------------------------------
# 2. 瑞幸 CLI（一般不用配）
# ----------------------------------------------------------------------------
# luckin.exe 路径，默认自动取 %LOCALAPPDATA%\.luckin\bin\luckin.exe
# LUCKIN_EXE=C:\Users\Relax\AppData\Local\.luckin\bin\luckin.exe
# CLI 会自己读 ~/.luckin/.env 里的 Token，仅在需要覆盖时填写
# LUCKIN_MCP_ORDER_TOKEN=xxxxxx
LUCKIN_TIMEOUT=120

# 可选：默认定位，省得每次问位置
# LUCKIN_LAT=39.9042
# LUCKIN_LNG=116.4074

# ----------------------------------------------------------------------------
# 3. Web 服务
# ----------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# 想让手机/同事访问就改成 HOST=0.0.0.0，并强烈建议设一个口令
# WEB_PASSWORD=my-secret

# 跨域白名单：默认留空 = 只允许同源（最安全）。
# 只有静态页面托管在别处（例如 GitHub Pages）却要连你这台机器的服务时才需要放行，
# 多个用英文逗号分隔：
#   WEB_ALLOW_ORIGINS=https://你的用户名.github.io
# ⚠️ 填 * 会让任何网页都能调用本服务下单，务必同时设置 WEB_PASSWORD。
# WEB_ALLOW_ORIGINS=

# 是否用 segno 生成支付二维码
ENABLE_QR=true
